rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.id == userId
                    && request.resource.data.role in ['OYUNCU', 'ISLETME_SAHIBI', 'PERSONEL'];
      allow update: if isOwner(userId)
                    && request.resource.data.role == resource.data.role; // Prevent self privilege escalation
      allow delete: if isOwner(userId);
    }

    // Businesses
    match /businesses/{businessId} {
      allow read: if true; // Public catalog
      allow create, update, delete: if isSignedIn()
        && (exists(/databases/$(database)/documents/staff_memberships/$(businessId + '_' + request.auth.uid))
            || request.resource.data.ownerUserId == request.auth.uid);
    }

    // Courts
    match /courts/{courtId} {
      allow read: if true; // Public view
      allow write: if isSignedIn();
    }

    // Reservations
    match /reservations/{reservationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.ownerUserId == request.auth.uid;
    }

    // Reservation Slots (Atomic conflict prevention)
    match /reservation_slots/{slotId} {
      allow read: if true;
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/reservation_slots/$(slotId));
      allow delete: if isSignedIn();
    }

    // Open Match Participants
    match /open_match_participants/{participantId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn();
    }

    // Open Match Waitlists
    match /open_match_waitlists/{waitlistId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn();
    }

    // Court Blocks
    match /court_blocks/{blockId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
