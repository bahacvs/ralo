# Server
PORT=3000
NODE_ENV=development

# Postgres connection. Local: `bun run db:up` (docker compose). Production: Supabase connection string.
# Leave empty to use the JSON file store in data/ (development only).
DATABASE_URL="postgresql://ralo:ralo_dev@localhost:5433/ralo"
# Remote databases verify the TLS certificate. Supabase: download the project CA certificate
# (Database settings > SSL) and paste the PEM here (newlines may be written as \n).
DATABASE_SSL_CA=""
# Only set to false as a temporary workaround; it disables certificate verification.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Public URL of the deployed app (share links and the links inside verification/password emails)
APP_URL="https://ralo.example.com"

# DEMO_MODE=true exposes the role switcher, lets unverified accounts book
# and refreshes demo seed data on boot. Never enable it in production.
DEMO_MODE=false
# Build-time flag that shows the demo role switcher in the UI; keep in sync with DEMO_MODE
VITE_DEMO_MODE=false

# Email for verification, password reset and staff invitation links: "smtp" or "console"
# (prints the email to the server log). Defaults to smtp when NODE_ENV=production, console otherwise.
# Gmail: turn on 2-Step Verification for the RALO account, then create an app password
# (Google Account > Security > App passwords). SMTP_PASS is that 16-character app password.
MAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
# Sender shown to users, e.g. "RALO <ralo.destek@gmail.com>". Gmail only sends as the account's own address.
MAIL_FROM=""

# Optional: Gemini API key for AI captions on match share cards
GEMINI_API_KEY=""
