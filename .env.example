# Server
PORT=3000
NODE_ENV=development

# Public URL of the deployed app (used for share links)
APP_URL="https://ralo.example.com"

# DEMO_MODE=true exposes the role switcher, echoes OTP codes to the client
# and refreshes demo seed data on boot. Never enable it in production.
DEMO_MODE=false
# Build-time flag that shows the demo role switcher in the UI; keep in sync with DEMO_MODE
VITE_DEMO_MODE=false

# SMS provider for login codes: "netgsm" or "console" (prints codes to the server log).
# Defaults to netgsm when NODE_ENV=production, console otherwise.
SMS_PROVIDER=console
NETGSM_USERCODE=""
NETGSM_PASSWORD=""
# Approved sender name (originator) in Netgsm
NETGSM_MSGHEADER=""

# Optional: Gemini API key for AI captions on match share cards
GEMINI_API_KEY=""
